#!/bin/sh
# AppImage entry point. A release build bundles Python 3 + PyGObject + GTK 3
# (see bundle-python-gtk.sh). A thin local build falls back to the host python3.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"

# Remember a host python for the per-user piper venv, before PATH is changed.
if [ -z "${CURSOR_SPEAK_HOST_PYTHON:-}" ] && command -v python3 >/dev/null 2>&1; then
    _hp="$(command -v python3)"
    case "$(readlink -f "$_hp" 2>/dev/null || echo "$_hp")" in
        "$APPDIR"/*) ;;
        *) export CURSOR_SPEAK_HOST_PYTHON="$_hp" ;;
    esac
    unset _hp
fi

if [ -d "$APPDIR/apprun-hooks" ]; then
    for _hook in "$APPDIR/apprun-hooks"/*; do
        [ -f "$_hook" ] || continue
        # shellcheck disable=SC1090
        . "$_hook"
    done
    unset _hook
fi

export PYTHONPATH="$APPDIR/usr/lib/cursor-speak${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1

if [ -x "$APPDIR/usr/bin/python3" ] && [ -e "$APPDIR/usr/lib/cursor-speak/.bundled-python" ]; then
    export PYTHONHOME="${PYTHONHOME:-$APPDIR/usr}"
    exec "$APPDIR/usr/bin/python3" -m cursor_speak "$@"
fi

if ! command -v python3 >/dev/null 2>&1; then
    msg="Cursor Speak needs Python 3 and PyGObject. On Debian/Ubuntu: sudo apt install python3 python3-gi gir1.2-gtk-3.0 gir1.2-ayatanaappindicator3-0.1 python3-venv"
    echo "$msg" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send "Cursor Speak" "$msg"
    exit 1
fi

exec python3 -m cursor_speak "$@"
